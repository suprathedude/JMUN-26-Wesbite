---
layout: layouts/base.njk
title: Desk check-in
eleventyExcludeFromCollections: true
eleventyComputed:
  description: "Registration desk check-in for {{ site.name }} {{ site.year }} volunteers."
permalink: /qr/check/
pageCss: [qr]
pageJs: [qr-check]
hideNotice: true
---
{#- Desk check-in for volunteers (13 October, docs/QR.md). The page scans delegates' QR codes
    with the phone's back camera (src/js/qr-check.js) and sends each code, with the volunteer
    PIN, to /api/checkin.php. A code scanned with the phone's own camera app opens this page
    with the code after the # and works the same way. Not in the sitemap or the nav.
    Text: site.json qrCheck. -#}
{%- from "partials/icons.njk" import icon -%}
{%- set k = site.qrCheck -%}
<section class="qr check">
  <div class="container check__wrap">
    <div class="check__head">
      <h1 class="t-page qr__title">{{ k.title }}</h1>
      <p class="check__count" data-check-count hidden></p>
    </div>
    <p class="qr__intro">{{ k.intro }}</p>

    <form class="qr__form" data-check-pin hidden>
      <label class="qr__label" for="check-pin">{{ k.pinLabel }}</label>
      <div class="qr__row">
        <input class="qr__input" id="check-pin" name="pin" type="password" autocomplete="off" required aria-describedby="check-pin-note">
        <button class="btn btn--shiny" type="submit">{{ k.pinButton }}</button>
      </div>
      <p class="qr__note" id="check-pin-note">{{ k.pinNote }}</p>
    </form>

    {#- The scanner: the back camera's picture with a square to aim at. It flashes green, amber
        or red with each result, and the phone buzzes. -#}
    <div class="check__scanner">
      <div class="check__view" data-check-view hidden>
        <video class="check__video" muted playsinline autoplay aria-hidden="true" data-check-video></video>
        <span class="check__aim" aria-hidden="true"></span>
        <span class="check__flash" aria-hidden="true" data-check-flash></span>
        <p class="check__hint" aria-hidden="true">{{ k.cameraHint }}</p>
      </div>
      <div class="check__buttons">
        <button class="btn btn--shiny" type="button" data-check-start>{{ icon("scan-line") }}{{ k.scanButton }}</button>
        <button class="btn btn--outline" type="button" data-check-stop hidden>{{ k.stopButton }}</button>
      </div>
      <p class="qr__status" role="status" data-check-camera-note></p>
    </div>

    <div class="qr__card check__result" data-check-result aria-live="polite">
      <div class="check__line">
        <span class="check__icon" data-for="ok" aria-hidden="true">{{ icon("circle-check") }}</span>
        <span class="check__icon" data-for="warn" aria-hidden="true">{{ icon("clock") }}</span>
        <span class="check__icon" data-for="bad" aria-hidden="true">{{ icon("circle-x") }}</span>
        <p class="check__state" data-check-state>{{ k.waiting }}</p>
      </div>
      <dl class="qr__list" data-check-details hidden>
        {%- for d in site.qrPage.details %}
        <div class="qr__field">
          <dt>{{ d.label }}</dt>
          <dd data-check-field="{{ d.key }}"></dd>
        </div>
        {%- endfor %}
      </dl>
    </div>

    <form class="qr__form" data-check-email>
      <label class="qr__label" for="check-email">{{ k.emailLabel }}</label>
      <div class="qr__row">
        <input class="qr__input" id="check-email" name="email" type="email" autocomplete="off" required>
        <button class="btn btn--outline" type="submit">{{ k.emailButton }}</button>
      </div>
    </form>

    <div class="check__recent">
      <h2 class="qr__label">{{ k.recentTitle }}</h2>
      <ol class="check__list" role="list" data-check-recent>
        <li class="check__empty">{{ k.recentEmpty }}</li>
      </ol>
    </div>

    <div class="check__tools">
      <button class="btn btn--outline" type="button" data-check-download>{{ k.download }}</button>
      <button class="btn btn--outline" type="button" data-check-forget>{{ k.forget }}</button>
    </div>
  </div>
  <script type="application/json" data-check-messages>{{ k.messages | dump | safe }}</script>
  <script type="application/json" data-check-words>{{ { count: k.count } | dump | safe }}</script>
</section>
