{#- FAQ accordion. Each question is a button that shows or hides its answer (SPEC 6).
    Every item starts closed; a question opens when it is pressed. -#}
{%- from "partials/icons.njk" import icon -%}
{%- macro faqList(items, prefix="faq") -%}
<div class="faq-list" data-faq data-reveal>
  {%- for item in items %}
  <div class="faq-item">
    <h3>
      <button class="faq-q" type="button" id="{{ prefix }}-q{{ loop.index }}" aria-expanded="false" aria-controls="{{ prefix }}-a{{ loop.index }}">
        <span>{{ item.question }}</span>
        <span class="faq-toggle" aria-hidden="true">{{ icon("plus") }}</span>
      </button>
    </h3>
    <div class="faq-a" id="{{ prefix }}-a{{ loop.index }}" role="region" aria-labelledby="{{ prefix }}-q{{ loop.index }}">
      <p>{{ item.answer }}</p>
      {%- if item.link %}
      <a class="faq-a__link" href="{{ item.link.url }}">{{ item.link.label }}</a>
      {%- endif %}
    </div>
  </div>
  {%- endfor %}
</div>
{%- endmacro -%}
