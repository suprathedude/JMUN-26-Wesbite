---
layout: layouts/base.njk
title: Social Night
eleventyComputed:
  description: "Social Night, {{ socialNight.edition }}, on {{ socialNight.date }} in the {{ socialNight.place }} at {{ site.name }} {{ site.year }}. What to expect, what to wear{% if socialNight.photoBooth %}, the 3D photo booth{% endif %} and answers to common questions."
permalink: /social-night/
pageCss: [social-night]
pageJs: [social-night, faq]
bodyClass: page-night
---
{%- from "partials/faq.njk" import faqList -%}
{%- from "partials/cobweb.njk" import cobweb -%}
{%- set sn = socialNight -%}
{%- set time = sn.time if (sn.time | isSet) else "Time TBC" -%}

{#- Hero: reference/24's layout. OakMUN's globe becomes the moon; bats and embers are added
    by social-night.js (none with reduced motion, fewer on phones, paused off-screen). -#}
<section class="sn-hero" aria-labelledby="sn-title" data-night>
  <div class="sn-sky" aria-hidden="true" data-sky></div>
  {{ cobweb("cobweb--hero") }}
  <div class="container sn-hero__grid">
    <div class="sn-hero__art" aria-hidden="true">
      <div class="moon-lg">
        <span class="moon-lg__crater moon-lg__crater--1"></span>
        <span class="moon-lg__crater moon-lg__crater--2"></span>
        <span class="moon-lg__crater moon-lg__crater--3"></span>
        <span class="moon-lg__crater moon-lg__crater--4"></span>
      </div>
    </div>
    <div class="sn-hero__text">
      <h1 class="sn-hero__title" id="sn-title">Social Night <span>{{ sn.edition }}</span></h1>
      <p class="sn-hero__meta">{{ sn.date }} · {{ sn.place }} · {{ time }}</p>
      <a class="btn sn-btn" href="/#schedule">See the schedule</a>
    </div>
  </div>
</section>

<section class="sn-info" aria-label="Details">
  <div class="container sn-info__grid">
    <div class="sn-info__item">
      <h2 class="sn-info__title">What to expect</h2>
      <p>{{ sn.expect }}</p>
    </div>
    <div class="sn-info__item">
      <h2 class="sn-info__title">What to wear</h2>
      <p>{{ sn.dressCode }}</p>
    </div>
    <div class="sn-info__item">
      <h2 class="sn-info__title">When and where</h2>
      <dl class="sn-when">
        <div><dt>Day</dt><dd>{{ sn.day }}, {{ sn.date }}</dd></div>
        <div><dt>Place</dt><dd>{{ sn.place }}</dd></div>
        <div><dt>Time</dt><dd>{{ sn.time }}</dd></div>
      </dl>
    </div>
  </div>
</section>

{#- The photo booth shows once socialNight.json describes it (photoBooth isn't empty). -#}
{%- if sn.photoBooth | isSet %}
<section class="section sn-booth" aria-labelledby="booth-title">
  <div class="container sn-booth__grid">
    <div class="sn-booth__text">
      <h2 class="t-section sn-title" id="booth-title">3D photo booth</h2>
      <p class="sn-booth__lead">{{ sn.photoBooth }}</p>
    </div>
    <div class="sn-booth__media">
      {%- if sn.photoBoothImage | isSet %}
      <img src="/{{ sn.photoBoothImage }}" alt="The 3D photo booth" sizes="(max-width: 768px) 100vw, 520px" eleventy:widths="400,800">
      {%- else %}
      <span class="photo-tbc">Photo TBC</span>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

<section class="section sn-faq" aria-labelledby="sn-faq-title">
  {{ cobweb("cobweb--faq") }}
  <div class="container sn-faq__inner">
    <h2 class="t-section sn-title" id="sn-faq-title">Questions</h2>
    {{ faqList(sn.faq, "sn-faq") }}
  </div>
</section>
