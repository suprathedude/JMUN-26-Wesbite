{%- from "partials/icons.njk" import icon -%}
{%- from "partials/buttons.njk" import shine -%}
{#- The pop-ups (14 October): news shown after the page has loaded (nav.js), on the pages in
    site.json → notice.pages. Since 16 October there can be several (notice.popups): each one
    opens as the one before it is closed. With notice.everyVisit (15 October) they open on every
    visit to those pages; without it, once per browser until their text changes.

    A pop-up is either news (title, text, an optional flash box at the top with an optional link,
    an optional list of dates and a button) or a single headline in capitals, with the words in
    `highlight` picked out and an optional button. Native <dialog>s, so focus stays inside and Esc closes them;
    data-lenis-prevent lets the mouse wheel and trackpad scroll a long one while smooth
    scrolling holds the page still. -#}
{%- set n = site.notice -%}
{%- set key = n | dump | hash -%}
{%- for p in n.popups %}
{%- set titleId = "notice-title-" ~ loop.index %}
<dialog class="notice{% if p.headline %} notice--headline{% endif %}" aria-labelledby="{{ titleId }}" tabindex="-1" data-notice data-key="{{ key }}"{% if n.everyVisit %} data-every-visit{% endif %} data-lenis-prevent>
  <div class="notice__card">
    <button class="notice__x" type="button" aria-label="{{ n.close }}" data-notice-close>{{ icon("x") }}</button>
    {%- if p.headline %}
    {%- set at = p.headline.indexOf(p.highlight) if p.highlight else -1 %}
    <h2 class="notice__headline" id="{{ titleId }}">
      {%- if at > -1 -%}
      {{ p.headline.slice(0, at) | keepHyphened | safe }}<mark class="notice__mark">{{ p.highlight | keepHyphened | safe }}</mark>{{ p.headline.slice(at + p.highlight.length) | keepHyphened | safe }}
      {%- else -%}
      {{ p.headline | keepHyphened | safe }}
      {%- endif -%}
    </h2>
    {%- if p.link.url | isSet %}
    <div class="notice__actions">
      <a class="btn btn--shiny" href="{{ p.link.url }}" data-notice-link>{{ shine() }}{{ p.link.label }}</a>
    </div>
    {%- endif %}
    {%- else %}
    {%- if p.flash.title %}
    <div class="notice__flash">
      <span class="notice__flash-dot" aria-hidden="true"></span>
      <div>
        <p class="notice__flash-title">{{ p.flash.title }}</p>
        {%- if p.flash.text %}<p class="notice__flash-text">{{ p.flash.text }}</p>{% endif %}
        {%- if p.flash.link.url | isSet %}
        <a class="notice__flash-link" href="{{ p.flash.link.url }}">{{ p.flash.link.label }}{% if p.flash.link.url | isExternal %}<span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>
        {%- endif %}
      </div>
    </div>
    {%- endif %}
    <h2 class="notice__title" id="{{ titleId }}">{{ p.title }}</h2>
    {%- if p.text %}<p class="notice__text">{{ p.text }}</p>{% endif %}
    {#- The dates: the training sessions from newToMun.json (trainingDates: true, 16 October),
        so they're only ever typed once, and/or a list of its own. One that's over (done: true)
        is crossed out. -#}
    {%- set dates = [] %}
    {%- if p.trainingDates %}
    {%- for s in newToMun.training.sessions %}{% set dates = (dates.push({ label: newToMun.training.sessionLabel ~ " " ~ loop.index, date: s.date, done: s.done }), dates) %}{% endfor %}
    {%- endif %}
    {%- for d in p.dates %}{% set dates = (dates.push(d), dates) %}{% endfor %}
    {%- if dates | length %}
    <h3 class="notice__sub">{{ p.datesTitle }}</h3>
    <ul class="notice__dates" role="list">
      {%- for d in dates %}
      <li{% if d.done %} class="is-done"{% endif %}><span class="notice__label">{{ d.label }}</span><span class="notice__date">{{ d.date }}{% if d.done %}<span class="visually-hidden"> ({{ newToMun.training.doneLabel }})</span>{% endif %}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    <div class="notice__actions">
      {%- if p.link.url | isSet %}
      <a class="btn btn--shiny" href="{{ p.link.url }}" data-notice-link>{{ shine() }}{{ p.link.label }}</a>
      {%- endif %}
      <button class="btn btn--outline" type="button" data-notice-close>{{ n.close }}</button>
    </div>
    {%- endif %}
  </div>
</dialog>
{%- endfor %}
