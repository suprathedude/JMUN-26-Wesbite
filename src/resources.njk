---
layout: layouts/base.njk
title: Resources
eleventyComputed:
  description: "Background guides, International Press style guides, procedure documents and research links for {{ site.name }} {{ site.year }}."
permalink: /resources/
pageCss: [resources]
pageJs: [resources]
---
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/guide-card.njk" import guideCard -%}

{%- set rp = site.resourcesPage -%}
{%- set out = committees | guidesOut -%}
{%- set total = committees | length -%}

{#- One backdrop for the whole page, so the glows carry on behind every section. -#}
<div class="res-page">
<div class="orb res-page__orb res-page__orb--a" aria-hidden="true"></div>
<div class="orb res-page__orb res-page__orb--b" aria-hidden="true"></div>
<div class="orb res-page__orb res-page__orb--c" aria-hidden="true"></div>

<header class="res-head">
  <div class="container res-head__inner">
    <div>
      <h1 class="t-page">Resources.</h1>
      <p class="res-head__text">{{ rp.intro }}</p>
    </div>
    <div class="res-head__side">
      <span class="res-head__mark" aria-hidden="true">{{ site.chapter }}</span>
      <p class="res-head__pill">
        {%- if out == 0 %}{{ rp.guidesNone }}
        {%- elif out == total %}{{ rp.guidesAll }}
        {%- else %}{{ rp.guidesSome | fill({ count: out, total: total }) }}{% endif -%}
      </p>
    </div>
  </div>
</header>

{#- Background guides: the same entries as the committee pages, so releasing a guide is one
    line in committees.json (guide.file) plus the PDF. -#}
<section class="res-section" aria-labelledby="guides-title">
  <div class="container">
    <h2 class="t-section t-section--bar" id="guides-title">Background guides</h2>
    <div class="res-grid">
      {%- for c in committees %}
      {{ guideCard({ title: c.code, text: c.name, image: c.image, file: c.guide.file, linkLabel: "Open PDF", level: 3 }) }}
      {%- endfor %}
    </div>
  </div>
</section>
{#- International Press: one card that opens to show the Journalism and Photography guides.
    Without JavaScript both guides are simply shown under the card. -#}
{%- set ip = resources.ip %}
{%- set ipOut = ip.guides | selectattr("file") | list | length %}
<section class="res-section" aria-labelledby="ip-title" data-ip>
  <div class="container">
    <h2 class="t-section t-section--bar" id="ip-title">International Press</h2>
    <article class="guide ip-card">
      {%- if ip.image %}
      <img class="guide__img" src="/{{ ip.image }}" alt="" sizes="(max-width: 768px) 100vw, 820px" eleventy:widths="400,800">
      {%- endif %}
      <h3 class="guide__title">{{ ip.title }}</h3>
      <p class="guide__topic">{{ ip.description }}</p>
      <div class="guide__foot">
        <span class="guide__status{% if ipOut %} is-ready{% endif %}">
          {%- if ipOut == 0 %}Coming soon{% elif ipOut == ip.guides | length %}Available{% else %}{{ ipOut }} of {{ ip.guides | length }} out{% endif -%}
        </span>
        <button class="guide__link ip-card__toggle" type="button" aria-expanded="false" aria-controls="ip-guides" data-ip-toggle>
          <span data-ip-label>Show the {{ ip.guides | length | numberWord | lower }} guides</span>{{ icon("chevron-down") }}
        </button>
      </div>
    </article>
    <ul class="docs ip-guides" id="ip-guides" role="list" data-ip-panel>
      {%- for d in ip.guides %}
      {%- set ready = d.file | isSet %}
      <li class="doc{% if ready %} is-ready{% endif %}">
        <span class="doc__icon" aria-hidden="true">{{ icon(d.icon or "file-text") }}</span>
        <div class="doc__body">
          <span class="doc__pill">{{ "PDF" if ready else "Coming soon" }}</span>
          <h3 class="doc__title">
            {%- if ready %}<a href="/{{ d.file }}" target="_blank" rel="noopener">{{ d.title }} ↗<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
            {%- else %}{{ d.title }}{% endif -%}
          </h3>
          <p class="doc__text">{{ d.description }}</p>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="res-section" aria-labelledby="docs-title">
  <div class="container">
    <h2 class="t-section t-section--bar" id="docs-title">Essential documents</h2>
    <ul class="docs" role="list">
      {%- for d in resources.documents %}
      {%- set ready = d.file | isSet %}
      <li class="doc{% if ready %} is-ready{% endif %}">
        <span class="doc__icon" aria-hidden="true">{{ icon("file-text") }}</span>
        <div class="doc__body">
          <span class="doc__pill">{{ "PDF" if ready else "Coming soon" }}</span>
          <h3 class="doc__title">
            {%- if ready %}<a href="/{{ d.file }}" target="_blank" rel="noopener">{{ d.title }} ↗<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
            {%- else %}{{ d.title }}{% endif -%}
          </h3>
          <p class="doc__text">{{ d.description }}</p>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="res-section res-section--last" aria-labelledby="links-title">
  <div class="container">
    <h2 class="t-section t-section--bar" id="links-title">Research links</h2>
    <ul class="links" role="list">
      {%- for l in resources.researchLinks %}
      <li>
        <a class="link-card" href="{{ l.url }}" target="_blank" rel="noopener">
          <span class="link-card__domain">{{ l.url | domain }}</span>
          <span class="link-card__title">{{ l.title }} ↗<span class="visually-hidden"> (opens in a new tab)</span></span>
          <span class="link-card__text">{{ l.description }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
</div>
