---
layout: layouts/base.njk
title: Secretariat
description: Meet the Secretariat of Oakridge JMUN 2026.
permalink: /secretariat/
pageCss: [secretariat]
pageJs: [secretariat]
---
{%- from "partials/person-card.njk" import personCard -%}

<header class="sec-head">
  <div class="orb sec-head__orb" aria-hidden="true"></div>
  <div class="container">
    <h1 class="t-page sec-head__title">Meet the <span>Secretariat</span></h1>
    <p class="sec-head__text">{{ site.secretariatPage.intro }}</p>
  </div>
</header>

{#- Top six first, then the USGs, each in the order of secretariat.json (SPEC 9.4). -#}
{%- for group in [["leadership", "Senior Secretariat"], ["usg", "Under-Secretaries-General"]] %}
{%- set people = secretariat | where("group", group[0]) %}
{%- if people | length %}
<section class="container people-group" aria-labelledby="group-{{ group[0] }}">
  <h2 class="people-group__title{% if loop.first %} visually-hidden{% endif %}" id="group-{{ group[0] }}">{{ group[1] }}</h2>
  <div class="people">
    {%- for p in people %}
    {{ personCard(p) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- endfor %}
