---
layout: layouts/base.njk
title: Secretariat
eleventyComputed:
  description: "Meet the Secretariat of {{ site.name }} {{ site.year }}."
permalink: /secretariat/
pageCss: [secretariat]
pageJs: [secretariat]
---
{%- from "partials/person-card.njk" import personCard -%}

<header class="sec-head">
  <div class="orb sec-head__orb" aria-hidden="true"></div>
  <div class="container">
    <h1 class="t-page sec-head__title">Meet the <span>Secretariat</span></h1>
    <p class="sec-head__text">{{ site.secretariatPage.intro }}</p>
  </div>
</header>

{#- Top six first, then the USGs, each in the order of secretariat.json (SPEC 9.4). Inside a
    group, people with the same "row" number sit side by side, as on OakMUN XVI's page. -#}
{%- for group in [["leadership", "Senior Secretariat"], ["usg", "Under-Secretaries-General"]] %}
{%- set people = secretariat | where("group", group[0]) %}
{%- if people | length %}
<section class="container people-group" aria-labelledby="group-{{ group[0] }}">
  <h2 class="visually-hidden" id="group-{{ group[0] }}">{{ group[1] }}</h2>
  {%- for row in people | rows %}
  <div class="people-row" style="--n: {{ row | length }}" data-reveal>
    {%- for p in row %}
    {{ personCard(p, site.secretariatPage.blurbTBC) }}
    {%- endfor %}
  </div>
  {%- endfor %}
</section>
{%- endif %}
{%- endfor %}
