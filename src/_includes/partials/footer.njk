{%- from "partials/icons.njk" import icon -%}
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <span class="footer__crest">{% include "partials/crest.njk" %}</span>
      <p class="footer__wordmark"><span>{{ site.wordmark[0] }}</span> <span class="t-teal">{{ site.wordmark[1] }}</span></p>
      <p class="footer__desc">{{ site.description }}</p>
    </div>

    <div class="footer__divider" aria-hidden="true"></div>

    <nav class="footer__col" aria-labelledby="footer-links">
      <h2 class="footer__heading" id="footer-links">Quick links</h2>
      <ul class="footer__links" role="list">
        {%- for link in site.footer.quickLinks %}
        <li><a href="{{ link.url }}">{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Contact</h2>
      <dl class="footer__details">
        <div>
          <dt>Email</dt>
          <dd>
            {%- if "@" in site.contact.email -%}
            <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
            {%- else -%}
            {{ site.contact.email }}
            {%- endif -%}
          </dd>
        </div>
        {%- if site.contact.instagram %}
        <div>
          <dt>Instagram</dt>
          <dd><a href="https://www.instagram.com/{{ site.contact.instagram }}/" rel="noopener">@{{ site.contact.instagram }} ↗</a></dd>
        </div>
        {%- endif %}
        <div>
          <dt>Location</dt>
          <dd>{{ site.venue }}</dd>
        </div>
      </dl>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Event details</h2>
      <dl class="footer__details">
        <div>
          <dt>Dates</dt>
          <dd>{{ site.start | eventDates(site.end) }}</dd>
        </div>
        <div>
          <dt>Venue</dt>
          <dd>{{ site.venueShort }}</dd>
        </div>
        <div>
          <dt>Theme</dt>
          <dd>{% if site.theme.enabled %}{{ site.theme.words | join(" ") }}{% else %}Announced soon (TBC){% endif %}</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="container">
    <div class="footer__bottom">
      <p>{{ site.footer.copyright }}</p>
      <p>{{ site.footer.credit }}</p>
    </div>
  </div>
</footer>
