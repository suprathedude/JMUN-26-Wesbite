{#- Filter chips for committee categories (SPEC 9.2): "All", then each category in use, in the
    spec's order with plural labels, then any other category under its own name. -#}
{%- macro categoryChips(list, label="Filter by type") -%}
{%- set names = { "General Assembly": "General Assembly", "Council": "Councils", "Agency": "Agencies", "Assembly": "Assembly", "Crisis": "Crisis", "Press": "Press" } -%}
{%- set used = [] -%}
{%- for c in list %}{% if c.category not in used %}{% set used = (used.push(c.category), used) %}{% endif %}{% endfor -%}
<div class="chips" role="group" aria-label="{{ label }}">
  <span class="chips__label" aria-hidden="true">Filter:</span>
  <button class="chip" type="button" aria-pressed="true" data-filter="all">All</button>
  {%- for key, name in names %}{% if key in used %}
  <button class="chip" type="button" aria-pressed="false" data-filter="{{ key }}">{{ name }}</button>
  {%- endif %}{% endfor %}
  {%- for key in used %}{% if key not in names %}
  <button class="chip" type="button" aria-pressed="false" data-filter="{{ key }}">{{ key }}</button>
  {%- endif %}{% endfor %}
</div>
{%- endmacro -%}
