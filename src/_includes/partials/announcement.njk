{%- from "partials/icons.njk" import icon -%}
{#- The announcement strip. With more than one message in site.json → announcement.items, they
    take turns every few seconds (nav.js); hovering or focusing the strip holds the current one,
    and the close button hides the strip for the visit. -#}
{%- set note = site.announcement -%}
{%- if note.enabled and note.items | length -%}
<div class="strip" role="region" aria-label="Announcement" data-strip data-key="{{ note.items | dump | hash }}">
  <div class="strip__inner">
    <div class="strip__stack">
      {%- for item in note.items %}
      <p class="strip__text{% if loop.first %} is-active{% endif %}" data-strip-item{% if not loop.first %} aria-hidden="true"{% endif %}>
        {%- if item.link | isSet -%}
        <a href="{{ item.link }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ item.text }}{% if item.link | isExternal %}<span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>
        {%- else -%}
        {{ item.text }}
        {%- endif -%}
      </p>
      {%- endfor %}
    </div>
    <button class="strip__close" type="button" aria-label="Dismiss announcement" data-strip-close>{{ icon("x") }}</button>
  </div>
</div>
{%- endif -%}
