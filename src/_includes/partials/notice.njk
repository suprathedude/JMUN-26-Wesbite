{%- from "partials/icons.njk" import icon -%}
{%- from "partials/buttons.njk" import shine -%}
{#- The pop-up notice (14 October): news and dates, shown after the page has loaded (nav.js), on
    the pages in site.json → notice.pages. With notice.everyVisit (15 October) it opens on every
    visit to those pages; without it, once per browser until its text changes. A flash box at the
    top carries the most urgent line. A native <dialog>, so focus stays inside it and Esc closes
    it. -#}
{%- set n = site.notice -%}
<dialog class="notice" aria-labelledby="notice-title" tabindex="-1" data-notice data-key="{{ n | dump | hash }}"{% if n.everyVisit %} data-every-visit{% endif %}>
  <div class="notice__card">
    <button class="notice__x" type="button" aria-label="{{ n.close }}" data-notice-close>{{ icon("x") }}</button>
    {%- if n.flash.title %}
    <div class="notice__flash">
      <span class="notice__flash-dot" aria-hidden="true"></span>
      <div>
        <p class="notice__flash-title">{{ n.flash.title }}</p>
        {%- if n.flash.text %}<p class="notice__flash-text">{{ n.flash.text }}</p>{% endif %}
      </div>
    </div>
    {%- endif %}
    <h2 class="notice__title" id="notice-title">{{ n.title }}</h2>
    <p class="notice__text">{{ n.text }}</p>
    {%- if n.dates | length %}
    <h3 class="notice__sub">{{ n.datesTitle }}</h3>
    <ul class="notice__dates" role="list">
      {%- for d in n.dates %}
      <li><span class="notice__label">{{ d.label }}</span><span class="notice__date">{{ d.date }}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    <div class="notice__actions">
      {%- if n.link.url | isSet %}
      <a class="btn btn--shiny" href="{{ n.link.url }}" data-notice-link>{{ shine() }}{{ n.link.label }}</a>
      {%- endif %}
      <button class="btn btn--outline" type="button" data-notice-close>{{ n.close }}</button>
    </div>
  </div>
</dialog>
