---
layout: layouts/base.njk
title: Social Night
eleventyComputed:
  description: "Social Night, {{ socialNight.edition }}, on {{ socialNight.date }} in the {{ socialNight.place }} at {{ site.name }} {{ site.year }}. What to expect, what to wear{% if socialNight.photoBooth %}, the 3D photo booth{% endif %} and answers to common questions."
permalink: /social-night/
pageCss: [social-night]
pageJs: [social-night, faq]
bodyClass: page-night
portal: true
---
{%- from "partials/faq.njk" import faqList -%}
{%- from "partials/cobweb.njk" import cobweb -%}
{%- set sn = socialNight -%}
{%- set time = sn.time if (sn.time | isSet) else "Time TBC" -%}

{#- Hero: reference/24's layout. OakMUN's globe becomes the moon (a rendered image, see
    scripts/make-moon.mjs); bats and embers are added by social-night.js (none with reduced
    motion, fewer on phones, paused off-screen).
    The glyph portal (PLAN.md F22): social-night.js moves the sky, the title block and the
    opening lines (sn-front) into src/islands/social-portal.tsx, so you scroll into the night
    through the letters of portalWord. Without it the hero shows as it is. -#}
<div class="sn-intro" data-portal data-bundle="/js/social-portal.js" data-word="{{ sn.portalWord | join('|') }}" data-enter="Skip the intro">
  <div data-portal-root></div>
  <section class="sn-hero" aria-labelledby="sn-title">
    <div class="sn-scene" aria-hidden="true" data-portal-scene>
      <div class="sn-moon">
        <img src="/assets/img/social/moon.webp" alt="" eleventy:widths="300,600,900" sizes="(max-width: 768px) 200px, 460px" loading="eager" decoding="async">
      </div>
      <div class="sn-sky" data-sky></div>
    </div>
    {{ cobweb("cobweb--hero") }}
    <div class="container sn-hero__text" data-portal-content>
      <h1 class="sn-hero__title" id="sn-title">Social Night <span>{{ sn.edition }}</span></h1>
      <p class="sn-hero__meta">{{ sn.date }} · {{ sn.place }} · {{ time }}</p>
      <div><a class="btn sn-btn" href="/#schedule">See the schedule</a></div>
    </div>
  </section>
  <div class="sn-front" data-portal-front hidden>
    <p class="sn-front__eyebrow">{{ sn.edition }}</p>
    <p class="sn-front__meta">{{ sn.day }}, {{ sn.date }}</p>
    <p class="sn-front__hint">Scroll to go in</p>
  </div>
</div>

<section class="sn-info" aria-label="Details">
  <div class="container sn-info__grid" data-reveal>
    <div class="sn-info__item">
      <h2 class="sn-info__title">What to expect</h2>
      <p>{{ sn.expect }}</p>
    </div>
    <div class="sn-info__item">
      <h2 class="sn-info__title">What to wear</h2>
      <p>{{ sn.dressCode }}</p>
    </div>
    <div class="sn-info__item">
      <h2 class="sn-info__title">When and where</h2>
      <dl class="sn-when">
        <div><dt>Day</dt><dd>{{ sn.day }}, {{ sn.date }}</dd></div>
        <div><dt>Place</dt><dd>{{ sn.place }}</dd></div>
        <div><dt>Time</dt><dd>{{ sn.time }}</dd></div>
      </dl>
    </div>
  </div>
</section>

{#- The photo booth shows once socialNight.json describes it (photoBooth isn't empty). -#}
{%- if sn.photoBooth | isSet %}
<section class="section sn-booth" aria-labelledby="booth-title">
  <div class="container sn-booth__grid">
    <div class="sn-booth__text">
      <h2 class="t-section sn-title" id="booth-title" data-reveal="mask">3D photo booth</h2>
      <p class="sn-booth__lead">{{ sn.photoBooth }}</p>
    </div>
    <div class="sn-booth__media">
      {%- if sn.photoBoothImage | isSet %}
      <img src="/{{ sn.photoBoothImage }}" alt="The 3D photo booth" sizes="(max-width: 768px) 100vw, 520px" eleventy:widths="400,800">
      {%- else %}
      <span class="photo-tbc">Photo TBC</span>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

<section class="section sn-faq" aria-labelledby="sn-faq-title">
  {{ cobweb("cobweb--faq") }}
  <div class="container sn-faq__inner">
    <h2 class="t-section sn-title" id="sn-faq-title" data-reveal="mask">Questions</h2>
    {{ faqList(sn.faq, "sn-faq") }}
  </div>
</section>
