---
layout: layouts/base.njk
pagination:
  data: committees
  size: 1
  alias: committee
  addAllPagesToCollections: true
permalink: "/committees/{{ committee.slug }}/"
pageCss: [committees]
pageJs: [readmore]
eleventyComputed:
  title: "{{ committee.code }}"
  description: "{{ committee.name }} at {{ site.name }} {{ site.year }}: {{ 'style guides and team.' if committee.press else 'agenda, background guide and executive board.' }}"
---
{%- from "partials/gilt.njk" import frame, laurel, mark, cuts -%}
{%- set c = committee -%}
{#- The press committee (IP, "press": true) has no agenda or EB: its style guides and its
    team (committees.json → team) take their place (6 October). -#}
{%- set agendas = (c.agenda if (c.agenda | dump)[0] == "[" else [c.agenda]) if c.agenda else [] -%}
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/guide-card.njk" import guideCard -%}
{%- from "partials/doomsday.njk" import ddOpening -%}

{#- Hero card (reference/14). A committee with a "cinematic" opening (Doomsday) has that instead. -#}
{%- if c.cinematic %}
{{ ddOpening(c, site) }}
<script type="module" src="/js/doomsday.js"></script>
{%- else %}
<section class="c-hero" aria-labelledby="committee-title"{% if c.slug != "doomsday" %} style="view-transition-name: committee-{{ c.slug }}"{% endif %}>
  {%- if c.image %}
  <img class="c-hero__img" src="/{{ c.image }}" alt=""{% if c.imagePosition %} style="object-position: {{ c.imagePosition }}"{% endif %} loading="eager" fetchpriority="high" sizes="100vw" eleventy:widths="800,1200,1600">
  {%- else %}
  <span class="c-hero__tbc">Photo TBC</span>
  {%- endif %}
  {{ frame("corner") }}
  <a class="back-pill" href="/committees/">{{ icon("chevron-left") }}Back to committees</a>
  <span class="c-hero__rule" aria-hidden="true"></span>
  <h1 class="c-hero__code" id="committee-title" data-reveal="mask">{{ c.code }}</h1>
  <p class="c-hero__name" data-reveal>{{ c.name }}</p>
</section>
{%- endif %}

{#- Gold lines across the page behind the body, softened a little. Doomsday's body is in Doom's
    green instead, to match its opening (8 October). -#}
<div class="c-page{% if c.cinematic %} c-page--doom{% endif %}">
{{ cuts("committee", "gilt-cuts--soft") }}
<div class="container c-body">
  <section class="c-overview" aria-labelledby="overview-title">
    <h2 class="t-section" id="overview-title" data-reveal="mask">{{ c.code }} overview</h2>
    <p data-reveal>{{ c.overview }}</p>
  </section>

  {#- Agenda card (reference/15) -#}
  {%- if agendas | length %}
  <section class="agenda" aria-labelledby="agenda-title" data-reveal>
    <div>
      <h2 class="agenda__title" id="agenda-title">Committee agenda</h2>
    </div>
    <ol class="agenda__list" role="list">
      {%- for item in agendas %}
      <li class="agenda__item">
        <span class="agenda__num" aria-hidden="true">{{ ("0" ~ loop.index) if loop.index < 10 else loop.index }}</span>
        <p class="agenda__text{% if 'TBC' in item %} is-tbc{% endif %}">{{ item }}</p>
      </li>
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}

  <div class="c-grid" data-reveal>
    {%- if c.press %}
    {#- IP's style guides, released by setting their files in resources.json. -#}
    {%- for g in resources.ipGuides %}
    {{ guideCard({ tag: "Style guide", title: g.title, text: g.description, image: g.image, file: g.file, linkLabel: "Open PDF" }) }}
    {%- endfor %}
    {%- else %}
    {#- Background guide card. Releasing a guide = setting guide.file to its PDF. -#}
    {{ guideCard({ tag: c.code, title: "Background guide", text: agendas | join("; "), image: c.image, file: c.guide.file, linkLabel: "Open background guide" }) }}
    {%- endif %}
  </div>

  {%- if c.team %}
  {#- IP team (6 October): wide cards, photo beside name, role and bio. -#}
  <section class="eb" aria-labelledby="team-title">
    <h2 class="t-section t-section--bar" id="team-title" data-reveal="mask">{{ c.teamTitle }}</h2>
    <div class="eb__grid eb__grid--team" data-reveal>
      {%- for m in c.team %}
      <article class="eb-card eb-card--wide" data-readmore>
        <div class="eb-card__photo">
          {%- if m.photo %}
          <img src="/{{ m.photo }}" alt="{{ m.name }}, {{ m.role }}" sizes="(max-width: 768px) 40vw, 300px" eleventy:widths="400,800">
          {%- else %}
          <span class="photo-tbc">Photo TBC</span>
          {%- endif %}
        </div>
        <div class="eb-card__body">
          <h3 class="eb-card__name{% if not m.name %} is-tbc{% endif %}">{{ m.name or "Name TBC" }}</h3>
          <p class="eb-card__role">{{ m.role }}</p>
          {%- if m.bio %}
          <p class="eb-card__bio" id="bio-{{ c.slug }}-{{ loop.index }}">{{ m.bio }}</p>
          <button class="eb-card__more" type="button" aria-expanded="false" aria-controls="bio-{{ c.slug }}-{{ loop.index }}" hidden>Read more</button>
          {%- endif %}
        </div>
      </article>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if c.eb %}
  {#- Executive board (SPEC 8.6). An empty name reads "EB announced soon". -#}
  <section class="eb" aria-labelledby="eb-title">
    <h2 class="t-section t-section--bar" id="eb-title" data-reveal="mask">Executive board</h2>
    <div class="eb__grid" data-reveal>
      {%- for m in c.eb %}
      <article class="eb-card" data-readmore>
        <div class="eb-card__photo">
          {%- if m.photo %}
          <img src="/{{ m.photo }}" alt="{{ m.name }}, {{ m.role }}" sizes="(max-width: 768px) 40vw, 400px" eleventy:widths="400,800">
          {%- else %}
          <span class="photo-tbc">Photo TBC</span>
          {%- endif %}
        </div>
        <div class="eb-card__body">
          <p class="eb-card__role">{{ m.role }}</p>
          {%- if m.name %}
          <h3 class="eb-card__name">{{ m.name }}</h3>
          {%- if m.bio %}
          <p class="eb-card__bio" id="bio-{{ c.slug }}-{{ loop.index }}">{{ m.bio }}</p>
          <button class="eb-card__more" type="button" aria-expanded="false" aria-controls="bio-{{ c.slug }}-{{ loop.index }}" hidden>Read more</button>
          {%- endif %}
          {%- else %}
          <h3 class="eb-card__name is-tbc">EB announced soon</h3>
          {%- endif %}
        </div>
      </article>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

</div>
</div>
