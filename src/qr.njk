---
layout: layouts/base.njk
title: Get your QR code
eleventyComputed:
  description: "Get your QR code for {{ site.name }} {{ site.year }}."
permalink: /qr/
pageCss: [qr]
---
{%- from "partials/gilt.njk" import frame, laurel, mark -%}
{#- The QR page (4 October): laid out, not working yet. The button is disabled until codes
    are issued. Once they open, the card shows the code with the delegate's name, committee,
    allocation and link. The text is in site.json qrPage. -#}
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/buttons.njk" import shine -%}
{%- set q = site.qrPage -%}

<section class="qr">
  <div class="orb qr__orb" aria-hidden="true"></div>
  {{ frame("corner") }}
  {{ laurel("laurel--head") }}
  <div class="container qr__grid">
    <div class="qr__copy">
      <h1 class="t-page qr__title" data-reveal="mask">{{ q.title }}</h1>
      <p class="qr__intro" data-reveal>{{ q.intro }}</p>
      <form class="qr__form" data-reveal onsubmit="return false">
        <label class="qr__label" for="qr-email">Registration email</label>
        <div class="qr__row">
          <input class="qr__input" id="qr-email" type="email" autocomplete="email" placeholder="you@example.com">
          <button class="btn btn--shiny is-disabled" type="button" aria-disabled="true" aria-describedby="qr-note">{{ shine() }}{{ q.button }}</button>
        </div>
        <p class="qr__note" id="qr-note">{{ q.note }}</p>
      </form>
    </div>
    {#- The pass: the QR code, then who it belongs to. Every value is TBC until codes open. -#}
    <div class="qr__card" data-reveal="art">
      <div class="qr__code" aria-hidden="true">
        <span class="qr__frame">{{ icon("qr-code") }}</span>
        <span class="qr__placeholder">{{ q.placeholder }}</span>
      </div>
      <div class="qr__details">
        <h2 class="qr__details-title">{{ q.detailsTitle }}</h2>
        <dl class="qr__list">
          {%- for d in q.details %}
          <div class="qr__field">
            <dt>{{ d.label }}</dt>
            <dd>{{ d.value }}</dd>
          </div>
          {%- endfor %}
          <div class="qr__field">
            <dt>{{ q.link.label }}</dt>
            <dd>{%- if q.link.url | isSet %}<a href="{{ q.link.url }}">{{ q.link.url }}</a>{%- else %}TBC{%- endif %}</dd>
          </div>
        </dl>
        <p class="qr__details-note">{{ q.detailsNote }}</p>
      </div>
    </div>
  </div>
</section>
