---
layout: layouts/base.njk
title: New to MUN?
eleventyComputed:
  description: "A guide for first-time delegates at {{ site.name }} {{ site.year }}. How a committee session runs, what to prepare, what to say and what the words mean."
permalink: /new-to-mun/
pageCss: [new-to-mun]
---
{%- from "partials/gilt.njk" import frame, laurel, mark -%}
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/buttons.njk" import registerButton -%}
{%- set g = newToMun -%}

{#- Hero: the event-page layout from reference/24, with a delegate raising a placard where OakMUN
    has its globe. The photo is cut at the desk, so it stands on the hero's bottom edge. -#}
<section class="ntm-hero" aria-labelledby="ntm-title">
  <div class="orb ntm-hero__orb" aria-hidden="true"></div>
  {{ frame("corner") }}
  {{ laurel("laurel--head") }}
  <div class="container ntm-hero__grid">
    <div class="ntm-hero__art" data-reveal="art">
      <div class="ntm-hero__circle" aria-hidden="true"></div>
      <img class="ntm-hero__photo" src="/{{ g.intro.photo.src }}" alt="{{ g.intro.photo.alt }}" loading="eager" sizes="(max-width: 768px) 170px, 400px" eleventy:widths="340,600,800">
    </div>
    <div class="ntm-hero__text">
      <h1 class="ntm-hero__title" id="ntm-title" data-reveal="mask">New to <span class="t-teal">MUN?</span> <span>Start here.</span></h1>
      {%- for p in g.intro.text %}
      <p class="ntm-hero__lead" data-reveal>{{ p }}</p>
      {%- endfor %}
      <div class="ntm-hero__actions" data-reveal>
        {{ registerButton(site.nav.register) }}
        <a class="btn btn--outline" href="#session">How a session runs</a>
      </div>
    </div>
  </div>
</section>

{#- A real sequence, so it's numbered (SPEC 9.7). -#}
<section class="section ntm-steps" id="session" aria-labelledby="session-title">
  <div class="container ntm-steps__grid">
    <div class="ntm-steps__head">
      <h2 class="t-section t-section--bar" data-reveal="mask" id="session-title">How a committee session runs</h2>
      <p class="ntm-intro" data-reveal>{{ g.stepsIntro }}</p>
    </div>
    <ol class="steps" role="list" data-reveal>
      {%- for s in g.steps %}
      <li class="step">
        <span class="step__num" aria-hidden="true">{{ ("0" ~ loop.index) if loop.index < 10 else loop.index }}</span>
        <h3 class="step__title">{{ s.title }}</h3>
        <p class="step__text">{{ s.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section ntm-prep" aria-labelledby="prep-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="prep-title">Before the conference</h2>
    <p class="ntm-intro" data-reveal>{{ g.checklistIntro | fill({ date: site.start | dayMonth }) }}</p>
    <ul class="checklist" role="list" data-reveal>
      {%- for c in g.checklist %}
      <li class="check">
        <span class="check__icon" aria-hidden="true">{{ icon("circle-check") }}</span>
        <div>
          <h3 class="check__title">{{ c.title }}</h3>
          <p class="check__text">{{ c.text }}</p>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{#- Three cards in the site's usual navy and gold. -#}
<section class="section ntm-day" aria-labelledby="day-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="day-title">On the day</h2>
    <div class="day-panels" data-reveal>
      {%- for p in g.onTheDay %}
      <div class="day-panel">
        <span class="day-panel__icon" aria-hidden="true">{{ icon(p.icon) }}</span>
        <h3 class="day-panel__title">{{ p.title }}</h3>
        <ul class="day-panel__list">
          {%- for item in p.items %}
          <li>{{ item }}</li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

{#- Each phrase is a small white placard to read out (SPEC 9.7). -#}
<section class="section ntm-say" aria-labelledby="say-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="say-title">Say it like a delegate</h2>
    <p class="ntm-intro" data-reveal>{{ g.phrasesIntro }}</p>
    <ul class="phrases" role="list" data-reveal>
      {%- for p in g.phrases %}
      <li class="phrase">
        <div class="phrase__face">
          <h3 class="phrase__when">{{ p.when }}</h3>
          <p class="phrase__text">“{{ p.text }}”</p>
        </div>
        <span class="phrase__handle" aria-hidden="true"></span>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section ntm-words" id="glossary" aria-labelledby="glossary-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="glossary-title">Glossary</h2>
    <dl class="glossary" data-reveal>
      {%- for t in g.glossary %}
      <div class="glossary__item">
        <dt>{{ t.term }}</dt>
        <dd>{{ t.definition }}</dd>
      </div>
      {%- endfor %}
    </dl>
    {%- if g.note %}
    <p class="ntm-note" data-reveal>{{ icon("info") }}<span>{{ g.note }}</span></p>
    {%- endif %}
  </div>
</section>
