---
layout: layouts/base.njk
title: Committees
eleventyComputed:
  description: "The committees at {{ site.name }} {{ site.year }}, with agendas, background guides and chairs as they're released."
permalink: /committees/
pageCss: [committees]
pageJs: [filters]
---
{%- from "partials/gilt.njk" import frame, laurel, mark -%}
{%- from "partials/icons.njk" import icon -%}

<header class="listing-head">
  <div class="orb listing-head__orb" aria-hidden="true"></div>
  {{ frame("corner") }}
  {{ laurel("laurel--head") }}
  <div class="container">
    <h1 class="t-page" data-reveal="mask">Committees</h1>
    <p class="listing-head__text" data-reveal>{{ site.committeesPage.intro | fill({ count: committees | length | numberWord }) }}</p>
  </div>
</header>

<section class="container" aria-label="All committees" data-filters data-noun="committees" data-pill="View committee">
  <div class="filters" data-reveal>
    <div class="search">
      {{ icon("search") }}
      <label class="visually-hidden" for="committee-search">Search committees</label>
      <input id="committee-search" type="search" placeholder="Search committees" autocomplete="off" data-search>
    </div>
  </div>

  <p class="visually-hidden" role="status" aria-live="polite" data-count></p>

  <div class="tiles">
    {%- for c in committees %}
    {%- set eager = loop.index <= 4 %}
    {% include "partials/committee-tile.njk" %}
    {%- endfor %}
  </div>

  <p class="results-empty" hidden data-empty>No committees match that. <button type="button" data-reset>Show all committees</button></p>
</section>
