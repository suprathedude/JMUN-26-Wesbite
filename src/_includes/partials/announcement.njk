{%- from "partials/icons.njk" import icon -%}
{%- set note = site.announcement -%}
{%- if note.enabled and note.text -%}
<div class="strip" role="region" aria-label="Announcement" data-strip data-key="{{ note.text | hash }}">
  <div class="strip__inner">
    <p class="strip__text">
      {%- if note.link | isSet -%}
      <a href="{{ note.link }}"{% if note.link | isExternal %} target="_blank" rel="noopener"{% endif %}>{{ note.text }}{% if note.link | isExternal %}<span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>
      {%- else -%}
      {{ note.text }}
      {%- endif -%}
    </p>
    <button class="strip__close" type="button" aria-label="Dismiss announcement" data-strip-close>{{ icon("x") }}</button>
  </div>
</div>
{%- endif -%}
