---
layout: layouts/base.njk
title: Resources
eleventyComputed:
  description: "Background guides, International Press style guides, procedure documents and research links for {{ site.name }} {{ site.year }}."
permalink: /resources/
pageCss: [resources]
---
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/guide-card.njk" import guideCard -%}

{%- set rp = site.resourcesPage -%}
{%- set out = committees | guidesOut -%}
{%- set total = committees | length -%}

{#- One backdrop for the whole page, so the glows carry on behind every section. -#}
<div class="res-page">
<div class="orb res-page__orb res-page__orb--a" aria-hidden="true"></div>
<div class="orb res-page__orb res-page__orb--b" aria-hidden="true"></div>
<div class="orb res-page__orb res-page__orb--c" aria-hidden="true"></div>

<header class="res-head">
  <div class="container res-head__inner">
    <div>
      <h1 class="t-page" data-reveal="mask">Resources.</h1>
      <p class="res-head__text" data-reveal>{{ rp.intro }}</p>
    </div>
    <div class="res-head__side" data-reveal>
      <span class="res-head__mark" aria-hidden="true">{{ site.chapter }}</span>
      <p class="res-head__pill">
        {%- if out == 0 %}{{ rp.guidesNone }}
        {%- elif out == total %}{{ rp.guidesAll }}
        {%- else %}{{ rp.guidesSome | fill({ count: out, total: total }) }}{% endif -%}
      </p>
    </div>
  </div>
</header>

{#- Background guides: the same entries as the committee pages, so releasing a guide is one
    line in committees.json (guide.file) plus the PDF. -#}
<section class="res-section" aria-labelledby="guides-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="guides-title">Background guides</h2>
    <div class="res-grid" data-reveal>
      {%- for c in committees %}
      {{ guideCard({ title: c.code, text: c.name, image: c.image, file: c.guide.file, linkLabel: "Open PDF", level: 3 }) }}
      {%- endfor %}
    </div>
  </div>
</section>
{#- International Press style guides: two cards, each released like a background guide by
    setting its file in resources.json. -#}
<section class="res-section" aria-labelledby="ip-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="ip-title">International Press style guides</h2>
    <div class="res-grid res-grid--two" data-reveal>
      {%- for g in resources.ipGuides %}
      {{ guideCard({ tag: "Style guide", title: g.title, text: g.description, image: g.image, file: g.file, linkLabel: "Open PDF", level: 3 }) }}
      {%- endfor %}
    </div>
  </div>
</section>

<section class="res-section" aria-labelledby="docs-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="docs-title">Essential documents</h2>
    <ul class="docs" role="list" data-reveal>
      {%- for d in resources.documents %}
      {%- set ready = d.file | isSet %}
      <li class="doc{% if ready %} is-ready{% endif %}">
        <span class="doc__icon" aria-hidden="true">{{ icon("file-text") }}</span>
        <div class="doc__body">
          <span class="doc__pill">{{ "PDF" if ready else "Coming soon" }}</span>
          <h3 class="doc__title">
            {%- if ready %}<a href="/{{ d.file }}" target="_blank" rel="noopener">{{ d.title }} ↗<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
            {%- else %}{{ d.title }}{% endif -%}
          </h3>
          <p class="doc__text">{{ d.description }}</p>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="res-section res-section--last" aria-labelledby="links-title">
  <div class="container">
    <h2 class="t-section t-section--bar" data-reveal="mask" id="links-title">Research links</h2>
    <ul class="links" role="list" data-reveal>
      {%- for l in resources.researchLinks %}
      <li>
        <a class="link-card" href="{{ l.url }}" target="_blank" rel="noopener">
          <span class="link-card__domain">{{ l.url | domain }}</span>
          <span class="link-card__title">{{ l.title }} ↗<span class="visually-hidden"> (opens in a new tab)</span></span>
          <span class="link-card__text">{{ l.description }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
</div>
