---
layout: layouts/base.njk
title: Secretariat
eleventyComputed:
  description: "Meet the Secretariat of {{ site.name }} {{ site.year }}."
permalink: /secretariat/
pageCss: [secretariat]
pageJs: [secretariat]
---
{%- from "partials/gilt.njk" import frame, laurel, mark -%}
{%- from "partials/person-card.njk" import personCard -%}

<header class="sec-head">
  <div class="orb sec-head__orb" aria-hidden="true"></div>
  {{ frame("corner") }}
  {{ laurel("laurel--head") }}
  <div class="container">
    <h1 class="t-page sec-head__title" data-reveal="mask">Meet the <span>Secretariat</span></h1>
    <p class="sec-head__text" data-reveal>{{ site.secretariatPage.intro }}</p>
  </div>
</header>

{#- Everyone in one even grid, in the order of secretariat.json, like OakMUN's page: the top six,
    then the USGs. The group headings are for screen readers only. -#}
{%- for group in [["leadership", "Senior Secretariat"], ["usg", "Under-Secretaries-General"]] %}
{%- set people = secretariat | where("group", group[0]) %}
{%- if people | length %}
<section class="container people-group" aria-labelledby="group-{{ group[0] }}">
  <h2 class="visually-hidden" id="group-{{ group[0] }}">{{ group[1] }}</h2>
  <div class="people" data-reveal>
    {%- for p in people %}
    {{ personCard(p) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- endfor %}
