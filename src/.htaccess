# Server settings for GoDaddy Web Hosting (cPanel, Apache). The build copies this file to
# _site/.htaccess and the deploy uploads it with the rest of the site. See docs/DEPLOY.md.
#
# Every block is wrapped in <IfModule>, so a server without one of these modules skips that
# block instead of showing an error page.

# Pages: /committees/ serves /committees/index.html; unknown addresses get the 404 page.
DirectoryIndex index.html
ErrorDocument 404 /404.html

# GoDaddy's server ignores the ErrorDocument line above and sends a plain "404 Not Found"
# (found 12 October), so an address that matches no file or folder goes to 404.php, which
# sends the 404 page with a 404 status. Without PHP or mod_rewrite, the line above still applies.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/404\.(php|html)$
  RewriteRule ^ /404.php [L]
  # Folders with no page in them (/css/, /img/) too
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ /404.php [L]
</IfModule>

# web.config is for Windows hosting only; don't serve it.
<IfModule mod_authz_core.c>
  <Files "web.config">
    Require all denied
  </Files>
  # The QR system's shared code (docs/QR.md): only the other scripts load it.
  <Files "lib.php">
    Require all denied
  </Files>
</IfModule>

# File types older servers don't know. Without these, AVIF and WebP photos and the font
# may be sent with the wrong type and not show.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddCharset utf-8 .html .css .js .svg
</IfModule>

# Compress text files on the way out.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Security (12 October). The site loads nothing from other sites except Cloudflare's visitor
  # statistics (Real user monitoring), so scripts, styles, fonts, photos, video and requests may
  # only come from this site; the inline scripts are the site's own (the head script, the import
  # map). No other site may show this one in a frame (clickjacking), and browsers stay on https
  # for a year. Camera stays allowed here for a possible QR scanner; the rest are switched off.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Pages: browsers check for a newer version every time, and Cloudflare may keep a copy for up
  # to 10 minutes (s-maxage) and answer from near the visitor instead of GoDaddy's server, which
  # takes about half a second (12 October; needs the Cache Rule in docs/CLOUDFLARE.md). An update
  # shows within 10 minutes, or at once after Caching > Purge Everything.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate, s-maxage=600"
  </FilesMatch>

  # The QR pass and check-in answers (docs/QR.md) are never kept anywhere.
  <If "%{REQUEST_URI} =~ m#^/api/#">
    Header set Cache-Control "no-store"
  </If>

  # Photos and videos in /assets/ keep their names when replaced, so a day at most.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=86400"
  </If>

  # CSS, JS and font files have a content hash in their names (css/site.0846a8fe.css), and so
  # do the photos in img/, so a changed file always has a new name. They can be kept a year.
  <FilesMatch "\.[0-9a-f]{8}\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^[A-Za-z0-9_-]{10}-[0-9]+\.(avif|webp|jpe?g|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Send every visitor to the https:// address. Turn this on only once the SSL certificate is
# active in GoDaddy (the padlock shows on https://your-address), by removing the # at the
# start of the five lines below.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
