---
layout: layouts/base.njk
eleventyComputed:
  description: "{{ site.fullName }}, {{ site.start | eventDates(site.end) }} at {{ site.venue }}."
pageCss: [home]
gallery: true
pageJs: [gallery, hero-video, countdown, marquee, stats, schedule, ring, faq]
---
{%- from "partials/gilt.njk" import frame, laurel, mark, cuts -%}
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/buttons.njk" import registerButton, shine -%}
{%- from "partials/faq.njk" import faqList -%}
{%- set dates = site.start | eventDates(site.end) -%}

{#- 1. Gallery intro (6 October): on the first homepage visit of a session, photos fly out of
    the dark (a React + Three.js island, src/islands/hero-gallery.tsx). Scrolling through
    site.gallery.screens screens hands over to the hero below; scrolling back up returns to
    the gallery (gallery.js). Without the script, with reduced motion or without WebGL there's
    no gallery: the track is the hero's height and the page starts at the hero. -#}
<div class="gallery-track" style="--gallery-screens: {{ site.gallery.screens }}" data-gallery-track>
<div class="gallery-stage" data-gallery-stage>

{#- 2. Hero (reference/02). -#}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    {%- if site.hero.image %}
    <img class="hero__img" src="/{{ site.hero.image }}" alt="" loading="eager" fetchpriority="high" sizes="100vw" eleventy:widths="800,1200,1600">
    {%- if site.hero.video | isSet %}
    {#- Sources are added by hero-video.js, so phones and reduced motion never download it. -#}
    <video class="hero__video" muted loop playsinline preload="none" aria-hidden="true" data-hero-video data-webm="/{{ site.hero.video }}.av1.webm" data-mp4="/{{ site.hero.video }}.h264.mp4"></video>
    {%- endif %}
    {%- endif %}
    <div class="hero__overlay"></div>
    <div class="hero__dots"></div>
    <div class="orb hero__orb--a"></div>
    <div class="orb hero__orb--b"></div>
    <div class="hero__watermark">{{ site.chapter }}</div>
  </div>
  {#- Gold frame lines and laurels from the 2026 poster (partials/gilt.njk) -#}
  {{ frame("full") }}
  {{ laurel("laurel--tl") }}
  {{ laurel("laurel--br") }}

  <div class="hero__content">
    <p class="hero__meta">Chapter {{ site.chapter }} · {{ dates }} · {{ site.city }}</p>
    <h1 class="t-hero hero__title" id="hero-title">{{ site.wordmark[0] }} <span>{{ site.wordmark[1] }}</span></h1>
    <div class="hero__actions">
      {{ registerButton(site.nav.register) }}
      <a class="btn btn--ghost" href="/committees/">Explore committees</a>
    </div>
    <div class="countdown" role="img" aria-label="The conference starts on {{ site.start | dayMonth }} {{ site.year }}" data-countdown data-start="{{ site.start }}" data-end="{{ site.end }}" data-during="Happening now" data-after="See you next year">
      {%- for unit in [["d", "Days"], ["h", "Hours"], ["m", "Mins"], ["s", "Secs"]] %}
      {%- if not loop.first %}<span class="countdown__sep" aria-hidden="true">:</span>{% endif %}
      <span class="countdown__unit" aria-hidden="true">
        <span class="countdown__value" data-unit="{{ unit[0] }}">00</span>
        <span class="countdown__label">{{ unit[1] }}</span>
      </span>
      {%- endfor %}
      <span class="countdown__status" data-countdown-status></span>
    </div>
  </div>
</section>

<div class="gallery" aria-hidden="true" data-gallery data-bundle="/js/hero-gallery.js" data-images="{{ site.gallery.images | dump }}">
  <div class="gallery__root" data-gallery-root></div>
  <p class="gallery__cue" data-gallery-cue>{{ site.gallery.cue }}<span class="gallery__cue-line"></span></p>
</div>
</div>
</div>

{#- 3. Committee marquee (reference/05): the committee codes, moving right to left. -#}
<div class="marquee" aria-hidden="true" data-marquee>
  <div class="marquee__track">
    {%- for copy in [1, 2] %}
    <div class="marquee__group">
      {%- for round in [1, 2] %}{% for c in committees %}
      <span class="marquee__item">{{ c.code }}</span><span class="marquee__dot"></span>
      {%- endfor %}{% endfor %}
    </div>
    {%- endfor %}
  </div>
</div>

{#- 4. Theme (reference/03, 04; the OakMUN recording of 7 October). Only the "announced soon"
    band until theme.enabled is true. Each word has a blurred copy behind it (CSS, from
    data-text), so theme-reveal.js can bring it from soft to sharp with opacity alone. Words
    in theme.highlight are teal. -#}
{%- if site.theme.enabled %}
{%- set themeLines = site.theme | themeWords %}
{%- set n = (themeLines | last | last).i %}
<section class="theme" aria-labelledby="theme-title" data-theme-reveal>
  <div class="theme__stage">
    <div class="theme__intro" aria-hidden="true" data-theme-intro>
      <p class="theme__pre">Presenting the</p>
      <p class="theme__big" data-text="Conference theme"><span class="theme__sharp">Conference theme</span></p>
    </div>
    <div class="theme__body">
      <p class="t-label theme__eyebrow" data-theme-part>Conference theme</p>
      <h2 class="theme__title" id="theme-title">
        {%- for line in themeLines %}
        <span class="theme__line">
          {%- for w in line %}
          <span class="theme__word{% if w.highlight %} is-highlight{% endif %}" data-theme-part data-theme-word data-text="{{ w.word }}" style="--i: {{ w.i }}"><span class="theme__sharp">{{ w.word }}</span></span>{{ " " if not loop.last }}
          {%- endfor %}
        </span>
        {%- endfor %}
      </h2>
      <span class="theme__divider" data-theme-part style="--i: {{ n + 1 }}"></span>
      <p class="theme__caption" data-theme-part style="--i: {{ n + 2 }}">{{ site.theme.caption }}</p>
    </div>
  </div>
</section>
<script type="module" src="/js/theme-reveal.js"></script>
{%- else %}
<section class="theme-band" aria-label="Conference theme">
  <p class="theme-band__text">Conference theme announced soon</p>
</section>
{%- endif %}

{#- 5. Stats (reference/05). Numbers come from site.json; the committee count from committees.json. -#}
<section class="stats" aria-label="Oakridge JMUN in numbers">
  <div class="container">
    <ul class="stats__grid" role="list" data-reveal>
      {%- for stat in [
        { label: "Delegates", value: site.stats.delegates, gold: true },
        { label: "Committees", value: committees | length },
        { label: "Days", value: site.stats.days },
        { label: "Chapter", value: site.stats.chapter, gold: true }
      ] %}
      {%- set parts = stat.value | countParts %}
      <li class="stat{% if stat.gold %} stat--gold{% endif %}">
        <span class="stat__num" aria-hidden="true"{% if parts %} data-count="{{ parts.num }}" data-suffix="{{ parts.suffix }}"{% endif %}>{{ stat.value }}</span>
        <span class="stat__label"><span class="visually-hidden">{{ stat.value }} </span>{{ stat.label }}</span>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{#- 6. Letter from the Secretary-General (reference/06) -#}
{%- set sg = site.sgLetter %}
<section class="section letter" aria-labelledby="letter-title">
  <div class="orb letter__orb" aria-hidden="true"></div>
  <div class="container letter__grid">
    <div class="letter__photo" data-reveal="art">
      {%- if sg.photo %}
      <img src="/{{ sg.photo }}" alt="{{ sg.name }}, {{ sg.role }}" sizes="(max-width: 768px) 320px, 380px" eleventy:widths="400,800">
      {%- else %}
      <span class="photo-tbc">Photo TBC</span>
      {%- endif %}
    </div>
    <div>
      <h2 class="letter__title" id="letter-title" data-reveal="mask">A letter from the {{ sg.role }}</h2>
      <div class="letter__body" data-reveal>
        {%- for paragraph in sg.paragraphs %}
        <p>{{ paragraph }}</p>
        {%- endfor %}
      </div>
      <div class="letter__sign" data-reveal>
        {%- if sg.signature %}
        <img class="letter__signature" src="/{{ sg.signature }}" alt="" eleventy:widths="320">
        {%- endif %}
        <p class="letter__name">{{ sg.name }}</p>
        <p class="letter__role">{{ sg.role }}, {{ site.name }} {{ site.year }}</p>
      </div>
      <a class="text-link" href="/secretariat/">Meet the Secretariat</a>
    </div>
  </div>
</section>

{#- 7. Schedule (reference/07; layout from OakMUN XVI's later schedule): one day at a time,
    picked with tabs whose highlight glides across (schedule.js). Each day has a line down the
    left that fills as you scroll. Without the script both days show, one under the other.
    "Share timetable" draws both days into one image from the rows below. -#}
<section class="section schedule" id="schedule" aria-labelledby="schedule-title" data-schedule data-share-title="{{ site.name }} {{ site.year }}" data-share-dates="{{ site.start | eventDates(site.end) }} · {{ site.venueShort }}" data-share-url="{{ site.url | replace('https://', '') }}">
  <div class="container">
    <div class="schedule__head">
      <div>
        <h2 class="t-section t-section--bar" id="schedule-title" data-reveal="mask">{{ schedule.title }}</h2>
        {%- if schedule.note %}
        <p class="schedule__note" data-reveal>{{ schedule.note }}</p>
        {%- endif %}
      </div>
      <div class="sched-tabs" role="tablist" aria-label="Conference days" style="--count: {{ schedule.days | length }}" data-sched-tabs data-reveal>
        <span class="sched-tabs__pill" aria-hidden="true"></span>
        {%- for day in schedule.days %}
        <button class="sched-tab" type="button" role="tab" id="{{ day.id }}-tab" aria-controls="{{ day.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ day.tab }}</button>
        {%- endfor %}
      </div>
    </div>

    {%- for day in schedule.days %}
    <div class="sched-day{% if loop.first %} is-active{% endif %}" id="{{ day.id }}" role="tabpanel" aria-labelledby="{{ day.id }}-tab" data-day-label="{{ day.label }}" data-day-date="{{ day.dateLabel }}">
      <h3 class="sched-day__title">{{ day.label }} <span class="sched-day__date">{{ day.dateLabel }}</span></h3>
      <div class="sched-day__body" data-line>
        <span class="sched-line" aria-hidden="true"><span class="sched-line__fill"></span></span>
        <ol class="sched-list" role="list">
          {%- for e in day.events %}
          <li class="sched-item sched-item--{{ e.type }}" data-reveal>
            <span class="sched-item__dot" aria-hidden="true"></span>
            <p class="sched-item__time">
              {%- if e.start == "TBC" -%}Time TBC
              {%- elif e.end and e.end != "TBC" -%}{{ e.start }} to {{ e.end }}
              {%- else -%}{{ e.start }} onwards{%- endif -%}
            </p>
            <div class="sched-item__text">
              <p class="sched-item__title">
                {%- if e.link %}<a href="{{ e.link }}">{{ e.title }}</a>{% else %}{{ e.title }}{% endif -%}
              </p>
              {%- set dur = e.start | duration(e.end) %}
              {%- if dur %}
              <p class="sched-item__meta">{{ dur }}</p>
              {%- endif %}
            </div>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </div>
    {%- endfor %}

    <div class="schedule__share">
      <button class="btn btn--outline" type="button" data-sched-share data-file="{{ schedule.share.file }}" data-heading="{{ schedule.title }}" hidden>{{ icon("share-2") }}{{ schedule.share.label }}</button>
    </div>
  </div>
</section>

{#- 8. Committees at a glance (reference/08; ring from 6 October): the title on top and a ring of
    committee cards underneath, turning slowly and nudged round by scrolling (ring.js loads the
    React island, src/islands/committee-ring.tsx). Without the script, or with reduced motion,
    the plain list of committees below stays. -#}
{%- set ringItems = [] -%}
{%- for c in committees -%}
{%- set _ = ringItems.push({ common: c.code, binomial: c.name, href: "/committees/" ~ c.slug ~ "/", photo: { url: committeePhotos[c.slug] or "", text: "", pos: c.imagePosition or "center" } }) -%}
{%- endfor %}
<section class="section glance" aria-labelledby="glance-title">
  <div class="container glance__head">
    <h2 class="t-section" id="glance-title" data-reveal="mask">Committees at a glance.</h2>
    <p class="glance__text" data-reveal>{{ site.home.glanceText | fill({ count: committees | length | numberWord }) }}</p>
    <div class="glance__cta" data-reveal><a class="btn btn--primary" href="/committees/">Explore committees</a></div>
  </div>
  <div class="ring" data-ring data-bundle="/js/committee-ring.js">
    <script type="application/json" data-ring-items>{{ ringItems | dump | safe }}</script>
    <div class="ring__root" data-ring-root></div>
    <ul class="container glance-list" role="list">
      {%- for c in committees %}
      <li>
        <a class="glance-list__link" href="/committees/{{ c.slug }}/">
          <span class="glance-list__icon" aria-hidden="true">
            {%- if c.logo %}<img src="/{{ c.logo }}" alt="" eleventy:widths="160">{% else %}{{ icon("globe") }}{% endif -%}
          </span>
          <span class="glance-list__name">{{ c.code }}<span class="visually-hidden">: {{ c.name }}</span></span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{#- 9. More than debate (reference/10) -#}
<section class="section debate" aria-labelledby="debate-title">
  <div class="orb debate__orb" aria-hidden="true"></div>
  <div class="container">
    <h2 class="t-section debate__title" id="debate-title" data-reveal="mask">More than <em>debate.</em></h2>
    <p class="debate__text" data-reveal>{{ site.home.debateText }}</p>
    <div class="debate__grid" data-reveal>
      <article class="card card--night">
        {#- The Social Night moon (scripts/make-moon.mjs), rising out of the top corner -#}
        <span class="moon" aria-hidden="true"><img src="/assets/img/social/moon.webp" alt="" sizes="260px" eleventy:widths="300,600"></span>
        <span class="card__bar" aria-hidden="true"></span>
        <p class="card__tag">{{ socialNight.day }}, {{ socialNight.date }}</p>
        <h3 class="card__title">Social Night</h3>
        <p class="card__sub">{{ socialNight.edition }}</p>
        <p class="card__text">{{ socialNight.expect }}</p>
        <a class="card__link" href="/social-night/">About Social Night</a>
      </article>
      <article class="card">
        <span class="card__bar" aria-hidden="true"></span>
        <p class="card__tag">For first-timers</p>
        <h3 class="card__title">New to MUN?</h3>
        <p class="card__text">{{ site.home.newToMunText }}</p>
        <a class="card__link" href="/new-to-mun/">Read the guide</a>
      </article>
    </div>
  </div>
</section>

{#- 10. FAQ (reference/09) -#}
<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <h2 class="t-page" id="faq-title" data-reveal="mask">FAQ</h2>
    <p class="faq__intro" data-reveal>{{ site.home.faqIntro }}</p>
    {{ faqList(faq, "faq") }}
  </div>
</section>

{#- 11. Closing banner. Hidden only if the register link is removed entirely. -#}
{%- if site.nav.register.url %}
<section class="closing" aria-labelledby="closing-title">
  {{ cuts() }}
  <div class="container closing__inner">
    <h2 class="closing__title" id="closing-title" data-reveal="mask">{{ site.home.closing | fill({ date: site.start | dayMonth }) }}</h2>
    {{ registerButton(site.nav.register, "", false) }}
  </div>
</section>
{%- endif %}

{#- 12. Sponsors (reference/11): only when site.json lists some -#}
{%- if site.sponsors | length %}
<section class="sponsors" aria-labelledby="sponsors-title">
  <div class="container">
    <h2 class="sponsors__title" id="sponsors-title">Our sponsors</h2>
    <ul class="sponsors__list" role="list">
      {%- for s in site.sponsors %}
      <li class="sponsors__item">
        {%- if s.url %}<a href="{{ s.url }}" rel="noopener">{% endif -%}
        <img src="/{{ s.logo }}" alt="{{ s.name }}" eleventy:widths="400">
        {%- if s.url %}</a>{% endif -%}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}
