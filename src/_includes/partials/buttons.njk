{#- Buttons whose link may still be TBC. Until the URL is set, the Register button keeps
    its look for review but isn't a link (PLAN.md 5.2, S3). -#}

{#- The glow and shimmer layer inside a shiny button (btn--shiny, components.css). -#}
{%- macro shine() -%}<span class="btn__fx" aria-hidden="true"></span>{%- endmacro -%}

{#- shiny: the shiny style (default); false gives the plain teal button. -#}
{%- macro registerButton(reg, class="", shiny=true) -%}
{%- set look = "btn--shiny" if shiny else "btn--primary" -%}
{%- if reg.url | isSet -%}
<a class="btn {{ look }} {{ class }}" href="{{ reg.url }}"{% if reg.url | isExternal %} target="_blank" rel="noopener"{% endif %}>{{ shine() if shiny }}{{ reg.label }}{% if reg.url | isExternal %}<span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>
{%- else -%}
<a class="btn {{ look }} is-disabled {{ class }}" role="link" aria-disabled="true" title="Registration link TBC">{{ shine() if shiny }}{{ reg.label }}<span class="visually-hidden"> (link TBC)</span></a>
{%- endif -%}
{%- endmacro -%}

{#- The optional outlined button (Consent form). Hidden entirely until it has a link. -#}
{%- macro secondaryButton(sec, class="") -%}
{%- if sec.url | isSet -%}
<a class="btn btn--outline {{ class }}" href="{{ sec.url }}"{% if sec.url | isExternal %} target="_blank" rel="noopener"{% endif %}>{{ sec.label }}{% if sec.url | isExternal %}<span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>
{%- endif -%}
{%- endmacro -%}
